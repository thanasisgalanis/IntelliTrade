# ---- MetaTrader 5 ----
MT5_LOGIN=12345678
MT5_PASSWORD=changeme
MT5_SERVER=Broker-Demo
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ---- NewsAPI (https://newsapi.org) ----
NEWSAPI_KEY=your_newsapi_key_here
NEWS_QUERY=forex OR ECB OR "Federal Reserve" OR FOMC OR inflation
NEWS_LANGUAGE=en
NEWS_PAGE_SIZE=20

# ---- Anthropic Claude ----
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Trading config ----
RISK_PERCENT=1.0          # % of free margin risked per trade
MIN_CONFIDENCE=0.70       # Reject signals below this AI confidence
DEFAULT_PAIRS=EURUSD,GBPUSD,USDJPY
DEFAULT_SL_PIPS=20        # Default stop loss distance in pips
DEFAULT_TP_PIPS=40        # Default take profit distance in pips
MAX_SLIPPAGE_POINTS=10
MAGIC_NUMBER=20260504

# ---- Storage ----
SQLITE_PATH=data/news.db

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FILE=logs/intelitrade.log
